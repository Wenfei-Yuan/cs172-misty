{
  "manifest_version": 3,
  "name": "ADHD Reading Support",
  "version": "0.1.0",
  "description": "ADHD-friendly reading interface with robot companion support.",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "downloads"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Open Reading View",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "content_scripts": [],

  "web_accessible_resources": [
    {
      "resources": ["reader.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
